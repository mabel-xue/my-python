# 飞书配置
# 方式1：使用Webhook（推荐，简单易用）
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/6e03d8d3-d594-4fd4-b82e-5504ae805629

# 方式2：使用应用凭证（功能更强大，可以发送到指定群聊）
# FEISHU_APP_ID=cli_a49aa5319238100d
# FEISHU_APP_SECRET=64f5mm36H0VQGq0lVg4fQhVhvtSlWj12
# FEISHU_CHAT_ID=your_chat_id_here

